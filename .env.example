# Database Configuration (PostgreSQL by default, will fall back to SQLite if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db

# Application Configuration
APP_NAME=AI-Powered Intelligent Recruitment Assistance System
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
DEBUG=True

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,docx

# AI Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_LOCAL_FALLBACK_IF_MODEL_UNAVAILABLE=True
